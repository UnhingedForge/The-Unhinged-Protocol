  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheUnhingedProtocol.Application\TheUnhingedProtocol.Application.csproj" />
    <ProjectReference Include="..\TheUnhingedProtocol.Domain\TheUnhingedProtocol.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
  </ItemGroup>

</Project>
